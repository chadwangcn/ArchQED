{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArchQED control manifest",
  "type": "object",
  "required": ["schema_version", "project", "control_state", "source", "pending_change"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "project": {"type": "string"},
    "control_state": {"enum": ["ready", "awaiting_approval", "needs_compile"]},
    "source": {"type": "object"},
    "candidate_source": {"type": ["object", "null"]},
    "pending_change": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
